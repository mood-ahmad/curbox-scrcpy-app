package neth.iecal.curbox.kadb

import android.content.Context
import android.os.Build
import com.flyfishxu.kadb.Kadb
import com.flyfishxu.kadb.cert.KadbCert
import com.flyfishxu.kadb.cert.OkioFilePrivateKeyStore
import com.flyfishxu.kadb.mdns.KadbMdnsAndroid
import com.flyfishxu.kadb.mdns.MdnsEndpoint
import com.flyfishxu.kadb.shell.AdbShellResponse
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.flow.first
import kotlinx.coroutines.withContext
import kotlinx.coroutines.withTimeout
import okio.Path.Companion.toPath
import java.io.Closeable

/**
 * Isolated Kadb proof of concept.
 *
 * This class does not replace Shizuku and is not connected to the
 * ScrcpyOverWebRTC engine yet.
 *
 * Current goals:
 * 1. Persist the ADB host identity.
 * 2. Discover Wireless Debugging endpoints through mDNS.
 * 3. Pair using the Android six-digit pairing code.
 * 4. Connect to adbd.
 * 5. Execute shell("id").
 */
class KadbManager(
    context: Context
) : Closeable {

    private val appContext = context.applicationContext

    private val mdns = KadbMdnsAndroid(appContext)

    @Volatile
    private var discoveryStarted = false

    @Volatile
    private var identityInitialised = false

    /**
     * Initialises Kadb's persistent ADB host identity.
     *
     * The private key is stored under noBackupFilesDir so the same identity
     * can be reused after the CurBox process is restarted.
     */
    private fun initialiseIdentity() {
        if (identityInitialised) {
            return
        }

        synchronized(this) {
            if (identityInitialised) {
                return
            }

            val identityDirectory =
                appContext.noBackupFilesDir.resolve("kadb")

            if (
                !identityDirectory.exists() &&
                !identityDirectory.mkdirs() &&
                !identityDirectory.exists()
            ) {
                error("Unable to create Kadb identity directory")
            }

            val privateKeyPath =
                identityDirectory
                    .resolve("adbkey")
                    .absolutePath
                    .toPath()

            KadbCert.configure(
                store = OkioFilePrivateKeyStore(
                    privateKeyPath = privateKeyPath
                )
            )

            KadbCert.ensureReady()

            identityInitialised = true
        }
    }

    /**
     * Starts Wireless Debugging mDNS discovery.
     *
     * Calling this function more than once has no additional effect.
     */
    fun startDiscovery() {
        checkAndroidVersion()

        initialiseIdentity()

        if (!discoveryStarted) {
            mdns.start()
            discoveryStarted = true
        }
    }

    /**
     * Waits until Android publishes a Wireless Debugging pairing endpoint.
     */
    suspend fun awaitPairingEndpoint(
        timeoutMillis: Long = DEFAULT_DISCOVERY_TIMEOUT_MILLIS
    ): MdnsEndpoint = withContext(Dispatchers.IO) {
        startDiscovery()

        withTimeout(timeoutMillis) {
            mdns.state.first { state ->
                state.pairDevices.isNotEmpty()
            }.pairDevices.first()
        }
    }

    /**
     * Waits until Android publishes a Wireless Debugging connection endpoint.
     */
    suspend fun awaitConnectEndpoint(
        timeoutMillis: Long = DEFAULT_DISCOVERY_TIMEOUT_MILLIS
    ): MdnsEndpoint = withContext(Dispatchers.IO) {
        startDiscovery()

        withTimeout(timeoutMillis) {
            mdns.state.first { state ->
                state.connectDevices.isNotEmpty()
            }.connectDevices.first()
        }
    }

    /**
     * Pairs CurBox with Android Wireless Debugging.
     *
     * This only performs pairing. A separate connect endpoint is required
     * afterwards for shell commands.
     */
    suspend fun pair(
        pairingCode: String,
        timeoutMillis: Long = DEFAULT_DISCOVERY_TIMEOUT_MILLIS
    ): MdnsEndpoint = withContext(Dispatchers.IO) {
        validatePairingCode(pairingCode)

        val endpoint = awaitPairingEndpoint(timeoutMillis)

        Kadb.pair(
            host = endpoint.host,
            port = endpoint.port,
            pairingCode = pairingCode
        )

        endpoint
    }

    /**
     * Connects to the first discovered adbd connection endpoint and runs id.
     *
     * The expected proof-of-concept result is output containing:
     * uid=2000(shell)
     */
    suspend fun connectAndRunId(
        timeoutMillis: Long = DEFAULT_DISCOVERY_TIMEOUT_MILLIS
    ): KadbCommandResult = withContext(Dispatchers.IO) {
        val endpoint = awaitConnectEndpoint(timeoutMillis)

        val response = Kadb.create(
            host = endpoint.host,
            port = endpoint.port,
            connectTimeout = DEFAULT_CONNECT_TIMEOUT_MILLIS,
            socketTimeout = DEFAULT_SOCKET_TIMEOUT_MILLIS
        ).use { adb ->
            adb.shell("id")
        }

        response.toCommandResult(endpoint)
    }

    /**
     * Runs the full proof-of-concept flow:
     *
     * discover pairing endpoint
     * -> pair
     * -> discover connection endpoint
     * -> connect
     * -> shell("id")
     */
    suspend fun pairAndRunId(
        pairingCode: String,
        timeoutMillis: Long = DEFAULT_DISCOVERY_TIMEOUT_MILLIS
    ): KadbProofOfConceptResult = withContext(Dispatchers.IO) {
        val pairingEndpoint = pair(
            pairingCode = pairingCode,
            timeoutMillis = timeoutMillis
        )

        val commandResult = connectAndRunId(
            timeoutMillis = timeoutMillis
        )

        KadbProofOfConceptResult(
            pairingEndpoint = pairingEndpoint,
            connectEndpoint = commandResult.endpoint,
            commandResult = commandResult,
            shellAccessConfirmed = commandResult.output.contains(
                "uid=2000(shell)",
                ignoreCase = true
            )
        )
    }

    /**
     * Stops mDNS discovery without deleting the saved ADB identity.
     */
    fun stopDiscovery() {
        if (discoveryStarted) {
            mdns.stop()
            discoveryStarted = false
        }
    }

    /**
     * Releases mDNS resources.
     *
     * The persisted Kadb identity is intentionally retained.
     */
    override fun close() {
        discoveryStarted = false
        mdns.close()
    }

    private fun checkAndroidVersion() {
        check(Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
            "Wireless Debugging pairing requires Android 11 or newer"
        }
    }

    private fun validatePairingCode(pairingCode: String) {
        require(PAIRING_CODE_REGEX.matches(pairingCode)) {
            "Pairing code must contain exactly six digits"
        }
    }

    private fun AdbShellResponse.toCommandResult(
        endpoint: MdnsEndpoint
    ): KadbCommandResult {
        return KadbCommandResult(
            endpoint = endpoint,
            output = output,
            errorOutput = errorOutput,
            allOutput = allOutput,
            exitCode = exitCode
        )
    }

    data class KadbCommandResult(
        val endpoint: MdnsEndpoint,
        val output: String,
        val errorOutput: String,
        val allOutput: String,
        val exitCode: Int
    )

    data class KadbProofOfConceptResult(
        val pairingEndpoint: MdnsEndpoint,
        val connectEndpoint: MdnsEndpoint,
        val commandResult: KadbCommandResult,
        val shellAccessConfirmed: Boolean
    )

    companion object {
        private const val DEFAULT_DISCOVERY_TIMEOUT_MILLIS = 30_000L
        private const val DEFAULT_CONNECT_TIMEOUT_MILLIS = 15_000
        private const val DEFAULT_SOCKET_TIMEOUT_MILLIS = 15_000

        private val PAIRING_CODE_REGEX =
            Regex("^[0-9]{6}$")
    }
}

