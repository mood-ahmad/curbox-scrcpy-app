<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/engine_diagnostics_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_check_shizuku"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/engine_btn_check_shizuku"
        android:layout_marginBottom="6dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_list_files"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/engine_btn_list_files"
        android:layout_marginBottom="6dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_signaling_help"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/engine_btn_signaling_help"
        android:layout_marginBottom="6dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_agent_help"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/engine_btn_agent_help"
        android:layout_marginBottom="6dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cloudflared_log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/engine_btn_cloudflared_log"
        android:layout_marginBottom="6dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_signaling_log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/engine_btn_signaling_log"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/engine_output_label"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <ScrollView
        android:id="@+id/output_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/colorSurfaceVariant"
        android:padding="8dp">

        <TextView
            android:id="@+id/output_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textIsSelectable="true" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_copy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/engine_btn_copy"
            android:layout_marginEnd="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/engine_btn_clear"
            android:layout_marginStart="4dp" />

    </LinearLayout>

</LinearLayout>
