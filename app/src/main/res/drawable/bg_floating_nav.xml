<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_nav_fill" />
            <corners android:radius="34dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/glass_sheen_bottom"
                android:endColor="@color/glass_sheen_top" />
            <corners android:radius="34dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
            <corners android:radius="34dp" />
        </shape>
    </item>
</layer-list>
